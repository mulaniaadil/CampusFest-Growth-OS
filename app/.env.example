# Copy to .env.local for local development, or set in Vercel → Project → Settings → Environment Variables.
# Everything is optional: the product works fully without any of these.

# Gemini (free tier, Google AI Studio). Server-side only, never prefix with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Supabase (free tier). Project URL + anon public key (never the service_role key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_WORKSPACE_ID=campusfest-2025
